# Copy to .env.selfhost and generate unique random values before starting.
# Never commit the real .env.selfhost file.
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_RANDOM_LIVEKIT_SECRET

# Public DNS A/AAAA records must point these domains to your own server.
API_DOMAIN=api.example.com
LIVE_DOMAIN=live.example.com
LIVEKIT_URL=wss://live.example.com
CORS_ORIGIN=https://api.example.com
