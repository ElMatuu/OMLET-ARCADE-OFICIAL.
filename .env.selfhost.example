# Copy to .env.selfhost and generate unique random values before starting.
# Never commit the real .env.selfhost file.
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
LIVEKIT_API_KEY=REPLACE_WITH_RANDOM_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_RANDOM_LIVEKIT_SECRET
MONGO_ROOT_USERNAME=playverse_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_LONG_ALPHANUMERIC_PASSWORD
MONGO_APP_USERNAME=playverse_app
MONGO_APP_PASSWORD=REPLACE_WITH_32_CHAR_ALPHANUMERIC_OR_UNDERSCORE_PASSWORD

# Dedicated 32-byte key for encrypted creator RTMP stream keys
STREAM_KEY_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Optional private S3-compatible storage for LiveKit Egress recordings
LIVEKIT_RECORDING_S3_BUCKET=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET=
LIVEKIT_RECORDING_S3_REGION=
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_FORCE_PATH_STYLE=false

# Public DNS A/AAAA records must point these domains to your own server.
API_DOMAIN=api.example.com
LIVE_DOMAIN=live.example.com
LIVEKIT_URL=wss://live.example.com
LIVEKIT_INTERNAL_URL=http://livekit:7880
PLAYVERSE_API_URL=https://api.example.com
CORS_ORIGIN=https://api.example.com,https://localhost,capacitor://localhost,http://localhost
