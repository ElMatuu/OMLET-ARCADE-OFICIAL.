NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/playverse
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# LiveKit Cloud (keep the API secret only in the backend environment)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
