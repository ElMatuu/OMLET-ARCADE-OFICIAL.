NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/playverse
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Local-only self-hosted LiveKit development. Never expose these dev credentials publicly.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Required to encrypt creator RTMP stream keys at rest (32-byte hex or base64 key).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
STREAM_KEY_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key

# Optional LiveKit Egress recording storage (recording controls remain disabled until configured).
# Use a private S3-compatible bucket; credentials stay server-side and are never sent to clients.
LIVEKIT_RECORDING_S3_BUCKET=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET=
LIVEKIT_RECORDING_S3_REGION=
# Optional for S3-compatible providers such as MinIO or R2:
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_FORCE_PATH_STYLE=false

# OAuth app credentials (free developer apps) for linking creator accounts.
# Register these exact callback URLs with each provider using PLAYVERSE_API_URL.
PLAYVERSE_API_URL=https://api.example.com
PLAYVERSE_WEB_URL=https://playverse.example.com
APP_INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=replace-with-a-random-10-to-100-character-secret
